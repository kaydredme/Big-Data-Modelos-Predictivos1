# 1. Importar datos directo desde GitHub
grade_input <- read.csv("https://raw.githubusercontent.com/reisanar/datasets/master/clusters.csv")
# 2. Formatear los datos
kmdata_orig <- as.matrix(grade_input[, c("Student", "English", "Math", "Science")])
# 1. Importar los datos de la tarea directamente de GitHub
grade_input <- read.csv("https://raw.githubusercontent.com/reisanar/datasets/master/clusters.csv")
# 2. Formatear los datos
# Al tener solo 2 variables numéricas, pasamos todo directo a la matriz
kmdata <- as.matrix(grade_input)
# 3. Calcular la Suma de Cuadrados (WSS) para k = 1 hasta 15
wss <- numeric(15)
for (k in 1:15) {
wss[k] <- sum(kmeans(kmdata, centers=k, nstart=25)$withinss)
}
# 4. Generar la gráfica del "Codo"
plot(1:15, wss, type="b",
xlab="Number of Clusters",
ylab="Within Sum of Squares",
main="Método del Codo para clusters.csv")
# 5. Ejecutar el análisis K-means final
# Usaremos k=3 inicialmente, pero revisa la gráfica para confirmar el codo
km <- kmeans(kmdata, centers=3, nstart=25)
# --- RESULTADOS PARA TU REPORTE ---
print("--- Medias de los clústeres (Centers) ---")
print(km$centers)
print("--- WSS por clúster ---")
print(km$withinss)
View(grade_input)
View(km)
View(km)
View(kmdata)
print(km$withinss)
q
dev.off()
